# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=c64
# Set to false to ignore .prg/.d64 files posted by other bots and webhooks (e.g. CI build reports)
ALLOW_BOT_UPLOADS=true

# Server Configuration
PORT=3000
PUBLIC_HOST=http://localhost:3000

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=c64files
MINIO_USE_SSL=false

# File Management Configuration
MAX_FILES=100
MAX_AGE_DAYS=7
# Circuit breaker: a single cleanup run refuses to delete more than this.
# Deletion is irreversible, so a run that suddenly wants to remove far more than
# routine housekeeping stops and asks instead.
MAX_DELETIONS_PER_RUN=25

# SID Music Configuration
# Rendering happens on a worker thread; these control the MP3 the bot attaches.
SID_ENABLED=true
SID_RENDER_SECONDS=180
SID_FADE_SECONDS=5
SID_MP3_BITRATE=128
# sidlite is roughly 7x faster than residfp; residfp is the cycle-accurate reference
SID_ENGINE=sidlite
SID_RENDER_TIMEOUT_MS=60000
SID_QUEUE_LIMIT=8
SID_MAX_INPUT_BYTES=1048576
SID_MAX_MP3_BYTES=8388608
SID_MAX_FILES_PER_MESSAGE=4
# Optional paths to C64 ROM images, needed only by some RSID tunes.
# These are copyrighted - never commit them.
# SID_KERNAL_ROM=
# SID_BASIC_ROM=
# SID_CHARGEN_ROM= 